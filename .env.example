# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Confluent Cloud (Cloud resource management API key, not a cluster key) ---
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# --- SerpAPI (https://serpapi.com, the free plan gives 250 searches a month) ---
PRICE_API_KEY=

# --- AWS (standard credentials, used for the Lambda MCP server and SES) ---
# Either export AWS_PROFILE here, or rely on your normal AWS environment.
AWS_PROFILE=
AWS_REGION=eu-west-2

# --- Email for deal alerts (SES sandbox: this address is sender AND recipient) ---
# SES emails a verification link to this address after the first apply. Click it.
NOTIFY_EMAIL=

# --- Mandatory cloud resource tags (see README, Teardown) ---
OWNER_EMAIL=
OWNER_NAME=
TAG_MANAGED_BY=
# Short project name used in resource names and the cflt_managed_id tag.
PROJECT=blackfridaydemo
# Teardown date, YYYY-MM-DD, at most about 30 days out.
KEEP_UNTIL=2026-12-24
